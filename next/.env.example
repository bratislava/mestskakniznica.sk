# To start developing, copy this into .env.local

NEXT_PUBLIC_DEPLOYMENT=dev
NEXT_PUBLIC_IS_LOCALHOST=true

# Local Strapi (see strapi/README.md)
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
# Alternative: run against the deployed Strapi
# NEXT_PUBLIC_STRAPI_URL=https://city-library-strapi.staging.bratislava.sk

# Must match REVALIDATE_SECRET_TOKEN in strapi/.env.local
REVALIDATE_SECRET_TOKEN=<see-readme>

# Meilisearch — use "Default Search API Key", see the Meilisearch section in the root README.md
NEXT_PUBLIC_MEILISEARCH_HOST=http://localhost:7700
NEXT_PUBLIC_MEILISEARCH_SEARCH_API_KEY=<see-readme>
# Alternative: run against the deployed Meilisearch
# NEXT_PUBLIC_MEILISEARCH_HOST=https://city-library-strapi-meilisearch.staging.bratislava.sk
# NEXT_PUBLIC_MEILISEARCH_SEARCH_API_KEY=7294a7cf12c51fef6c521b27eb74561aad981cd8df1bfaf1626c8e03d1d7ad37

NEXT_PUBLIC_MAPBOX_PUBLIC_KEY=pk.eyJ1IjoiYnJhdGlzbGF2YTAxIiwiYSI6ImNreWp4d3RmbDJxdHcyb24wcTRzODV1Z2oifQ.ted1x1pbp8w3jZG0MygBUw

# Cloudflare Turnstile — the secret is the demo key that always passes:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAAAA0ntsHQvjN-Lua
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITEVERIFY_API=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Mailgun (contact forms)
MAILGUN_API_KEY=<contact-PM-if-needed>
MAILGUN_DOMAIN=sandboxa9861f03a870473b83e62ffee945e664.mailgun.org
MAILGUN_HOST=api.mailgun.net
MAILGUN_EMAIL=noreply@bratislava.sk

# Newsletter
ECOMAIL_API_KEY=<contact-PM-if-needed>

# Google Calendar (events export, see pages/api/calendar-auth-link.ts)
GOOGLE_CLIENT_ID=<contact-PM-if-needed>
GOOGLE_CLIENT_SECRET=<contact-PM-if-needed>
GOOGLE_REDIRECT_URL=http://localhost:3000/gAuth

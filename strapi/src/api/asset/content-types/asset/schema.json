{
  "kind": "collectionType",
  "collectionName": "assets",
  "info": {
    "singularName": "asset",
    "pluralName": "assets",
    "displayName": "Assety",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "originalTitle": {
      "type": "string"
    },
    "originalSlug": {
      "type": "string"
    },
    "file": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": ["images", "files"]
    },
    "description": {
      "type": "text",
      "required": false
    },
    "assetCategory": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::asset-category.asset-category",
      "inversedBy": "assets"
    }
  }
}
